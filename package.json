{
  "name": "hash.playwright.helper",
  "version": "1.0.0",
  "description": "A helper library for Playwright automation",
  "bin": {
    "playwright-proj": "./dist/cli.js",
    "pw-debug": "./bin/pw-debug.sh"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "postbuild": "npm run copy-template-files",
    "copy-template-files": "copyfiles --error -u 1 src/plop/templates/* dist/",
    "test": "echo \"Error: no test specified\" && exit 1",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "playwright",
    "automation",
    "helper",
    "testing"
  ],
  "author": "Hasham Babar <hasham.babar@audacia.co.uk>",
  "license": "ISC",
  "files": [
    "dist",
    "templates"
  ],
  "peerDependencies": {
    "@playwright/test": ">=1.45.0",
    "plop": ">=4.0.0",
    "get-port": ">=7.1.0",
    "dotenv": ">=16.4.7",
    "playwright-lighthouse": ">=4.0.0",
    "@faker-js/faker": ">=9.6.0"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^13.1.0",
    "copyfiles": "^2.4.1",
    "ejs": "^3.1.10",
    "figlet": "^1.8.0",
    "fs-extra": "^11.3.0"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/figlet": "^1.7.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.13.9"
  }
}